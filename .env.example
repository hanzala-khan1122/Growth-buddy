# =============================================================================
# GrowthBuddy — Environment Configuration Template
# Copy this file to .env and configure your production values
# =============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# Security / JWT Secret (Use a long random string in production)
JWT_SECRET=growthbuddy_super_secure_jwt_secret_key_2026_phase2_ai_agency
JWT_EXPIRES_IN=7d

# Database Path (SQLite file location)
DATABASE_PATH=./growthbuddy.db

# Nodemailer / SMTP Configuration for Contact Form Notifications
# Fill these in with your real email provider (SendGrid, Mailgun, AWS SES, Gmail, etc.)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM="GrowthBuddy AI Agency" <notifications@growthbuddy.agency>
ADMIN_NOTIFICATION_EMAIL=hello@growthbuddy.agency
